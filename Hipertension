from manim import *

class Hipertension(Scene):
    def construct(self):
        text = Text("Presión arterial elevada puede dañar tu cuerpo").scale(0.7)
        self.play(Write(text))
        self.wait(2)
        self.play(text.animate.shift(UP))
        
        arteria = Circle(radius=1, color=RED).scale(1.5)
        self.play(GrowFromCenter(arteria))
        
        for _ in range(5):
            self.play(arteria.animate.scale(1.2), run_time=0.2)
            self.play(arteria.animate.scale(0.8), run_time=0.2)

        self.wait(2)
